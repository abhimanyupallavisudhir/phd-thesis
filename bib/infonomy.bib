 file = {/home/manyu/gdrive/Gittable/Bib/zotmoov/Stuff/ai/search_and_retrieval/Yue et al. - 2024 - DOTS Learning to Reason Dynamically in LLMs via Optimal Reasoning Trajectories Search.pdf;/home/manyu/gdrive/Gittable/Bib/zotmoov/Stuff/ai/search_and_retrieval/2410.html},
 keywords = {Computer Science - Artificial Intelligence,Computer Science - Computation and Language,Computer Science - Machine Learning},
 month = {October},
