 month = {April},
 publisher = {MIT Press},
 shorttitle = {Adaptation in {{Natural}} and {{Artificial Systems}}},
 title = {Adaptation in {{Natural}} and {{Artificial Systems}}: {{An Introductory Analysis}} with {{Applications}} to {{Biology}}, {{Control}}, and {{Artificial Intelligence}}},
 year = {1992}
