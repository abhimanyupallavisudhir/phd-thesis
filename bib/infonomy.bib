@inproceedings{tadepalliHLearningReinforcementLearning1994,
 abstract = {In this paper, we introduce a model-bases reinforcement learning method called H-learning, which optimizes undiscounted average reward. We compare it with three other reinforcement learning methods in the domain of scheduling Automatic Guided Vehicles, and transportation robots used in modern manufacturing plants and facilities. The four methods differ along two dimensions. They are either model-based or model-free, and optimize discounted total reward or undiscounted average reward. Our experimental results indicate that H-learning is more robust with respect to changes in the domain parameters, and in many cases, converges in fewer steps to better average reward per time step than all the other methods. An added advantage is that unlike the other methods it does not have any parameters to tune.},
 author = {Tadepalli, Prasad and Ok, DoKyeong},
 collection = {/Stuff/ai/rl},
 file = {/home/manyu/gdrive/Gittable/Bib/zotmoov/Stuff/ai/rl/Tadepalli and Ok - 1994 - H-Learning A Reinforcement Learning Method for Optimizing Undiscounted Average Reward.pdf},
 shorttitle = {H-{{Learning}}},
 title = {H-{{Learning}}: {{A Reinforcement Learning Method}} for {{Optimizing Undiscounted Average Reward}}},
 urldate = {2025-01-11},
 year = {1994}
}

@inproceedings{ngoAlignmentProblemDeep2023,
 abstract = {AI systems based on deep learning have reached or surpassed human performance in a range of narrow domains. In coming years or decades, artificial general intelligence (AGI) may surpass human capabilities at many critical tasks. In this position paper, we examine the technical difficulty of fine-tuning hypothetical AGI systems based on pretrained deep models to pursue goals that are aligned with human interests. We argue that, if trained like today's most capable models, AGI systems could learn to act deceptively to receive higher reward, learn internally-represented goals which generalize beyond their fine-tuning distributions, and pursue those goals using power-seeking strategies. We review emerging evidence for these properties. AGIs with these properties would be difficult to align and may appear aligned even when they are not.},
 author = {Ngo, Richard and Chan, Lawrence and Mindermann, S{\"o}ren},
 booktitle = {The {{Twelfth International Conference}} on {{Learning Representations}}},
 collection = {/Stuff/alignment},
 file = {/home/manyu/gdrive/Gittable/Bib/zotmoov/Stuff/Mainstream AI work/General ML/Ngo et al_2023_The Alignment Problem from a Deep Learning Perspective.pdf},
