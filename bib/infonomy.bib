 issn = {1099-1468},
 journal = {Managerial and Decision Economics},
 langid = {english},
 number = {4},
 pages = {223--242},
 shorttitle = {Property Rights Theory, Transaction Costs Theory, and Agency Theory},
 title = {Property Rights Theory, Transaction Costs Theory, and Agency Theory: An Organizational Economics Approach to Strategic Management},
