 publisher = {PMLR},
 shorttitle = {Selling {{Data To}} a {{Machine Learner}}},
 title = {Selling {{Data To}} a {{Machine Learner}}: {{Pricing}} via {{Costly Signaling}}},
 urldate = {2024-06-18},
 year = {2022}
