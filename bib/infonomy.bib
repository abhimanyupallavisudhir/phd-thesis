@book{moschovakisDescriptiveSetTheory2009,
 abstract = {Descriptive Set Theory is the study of sets in separable, complete metric spaces that can be defined (or constructed), and so can be expected to have special properties not enjoyed by arbitrary pointsets. This subject was started by the French analysts at the turn of the 20th century, most prominently Lebesgue, and, initially, was concerned primarily with establishing regularity properties of Borel and Lebesgue measurable functions, and analytic, coanalytic, and projective sets. Its rapid development came to a halt in the late 1930s, primarily because it bumped against problems which were independent of classical axiomatic set theory. The field became very active again in the 1960s, with the introduction of strong set-theoretic hypotheses and methods from logic (especially recursion theory), which revolutionized it. This monograph develops Descriptive Set Theory systematically, from its classical roots to the modern ``effective\&\#39;\&\#39; theory and the consequences of strong (especially determinacy) hypotheses. The book emphasizes the foundations of the subject, and it sets the stage for the dramatic results (established since the 1980s) relating large cardinals and determinacy or allowing applications of Descriptive Set Theory to classical mathematics. The book includes all the necessary background from (advanced) set theory, logic and recursion theory.},
 author = {Moschovakis, Yiannis N.},
 collection = {/Stuff/math/logic\_ordinals\_measure},
 file = {/home/manyu/gdrive/Gittable/Bib/zotmoov/Stuff/Math and logic/Logic, ordinals and measure/Moschovakis_2009_Descriptive Set Theory.pdf},
 isbn = {978-0-8218-4813-5},
 keywords = {Mathematics / Set Theory},
 langid = {english},
 month = {June},
 publisher = {American Mathematical Soc.},
 title = {Descriptive {{Set Theory}}},
 year = {2009}
}

@article{brehmerWhyScoringFunctions2019,
 abstract = {Motivated by the growing interest in sound forecast evaluation techniques with an emphasis on distribution tails rather than average behaviour, we investigate a fundamental question arising in this context: Can statistical features of distribution tails be elicitable, i.e. be the unique minimizer of an expected score? We demonstrate that expected scores are not suitable to distinguish genuine tail properties in a very strong sense. Specifically, we introduce the class of max-functionals, which contains key characteristics from extreme value theory, for instance the extreme value index. We show that its members fail to be elicitable and that their elicitation complexity is in fact infinite under mild regularity assumptions. Further we prove that, even if the information of a max-functional is reported via the entire distribution function, a proper scoring rule cannot separate max-functional values. These findings highlight the caution needed in forecast evaluation and statistical inference if relevant information is encoded by such functionals.},
 author = {Brehmer, Jonas R. and Strokorb, Kirstin},
 collection = {/Stuff/math/logic\_ordinals\_measure},
 doi = {10.1214/19-EJS1622},
 file = {/home/manyu/gdrive/Gittable/Bib/zotmoov/Stuff/Math and logic/Logic, ordinals and measure/Brehmer_Strokorb_2019_Why scoring functions cannot assess tail properties.pdf},
 issn = {1935-7524, 1935-7524},
 journal = {Electronic Journal of Statistics},
 keywords = {62C05,62G32,91B06,consistency,elicitability,elicitation complexity,extreme value index,max-functional,proper scoring rule,scoring functions,tail equivalence},
 month = {January},
 number = {2},
 pages = {4015--4034},
 publisher = {{Institute of Mathematical Statistics and Bernoulli Society}},
 title = {Why Scoring Functions Cannot Assess Tail Properties},
 urldate = {2023-04-27},
 volume = {13},
 year = {2019}
}

