 file = {/home/manyu/gdrive/Gittable/Bib/zotmoov/Stuff/zzz_Misc/CFcasting/Fluri et al_2023_Evaluating Superhuman Models with Consistency Checks.pdf;/home/manyu/gdrive/Gittable/Bib/zotmoov/Stuff/zzz_Misc/CFcasting/Fluri et al_2023_Evaluating Superhuman Models with Consistency Checks.html},
