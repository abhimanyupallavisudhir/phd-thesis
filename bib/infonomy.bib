@misc{sudhirGeneralisedCauchyDerivative2018,
 abstract = {It has recently been proven that the generalised Cauchy fractional derivative (also known as the Riemann-Liouville fractional derivative) is equal to the Grunwald-Letnikov derivative. However, we observe that there are "Grunwald non-differentiable" functions for which the latter derivative is not convergent, while the Riemann-Liouville derivative is. In this paper, we show that the Riemann-Liovuille derivative can be considered a "principal value" of the Grunwald-Letnikov derivative, requiring specific relative rates of approach for the limits \${\textbackslash}Delta x {\textbackslash}to 0\$ and \$N {\textbackslash}to {\textbackslash}infty\$ (where \$N\$ is the upper limit of the infinite summation) in the Grunwald derivative - i.e. instead of varying \${\textbackslash}Delta x\$ and \$N\$ independently, the two must satisfy a relation and be varied as a single limit. We proceed to calculate this relation for several functions and orders, finding that several possible such relations are possible for a given function, also placing requirements on the "handedness" of the fractional derivative. It is further shown that for functions with a Taylor expansion, the relation \${\textbackslash}Delta x=x/N\$ always produces the correct principal value.},
 archiveprefix = {arXiv},
 author = {Sudhir, Abhimanyu Pallavi},
 collection = {/Stuff/general\_reading/own\_work},
 eprint = {1809.08051},
 file = {/home/manyu/gdrive/Gittable/Bib/zotmoov/Stuff/general_reading/own_work/Sudhir - 2018 - The generalised Cauchy derivative as a principal value of the Grunwald-Letnikov fractional derivat.pdf;/home/manyu/gdrive/Gittable/Bib/zotmoov/Stuff/general_reading/own_work/Sudhir_2018_The generalised Cauchy derivative as a principal value of the.html},
 keywords = {26A33,Mathematics - Classical Analysis and ODEs},
 month = {October},
 number = {arXiv:1809.08051},
 primaryclass = {math},
 publisher = {arXiv},
 title = {The Generalised {{Cauchy}} Derivative as a Principal Value of the {{Gr}}{\textbackslash}"unwald-{{Letnikov}} Fractional Derivative for Divergent Expansions},
 urldate = {2023-12-27},
 year = {2018}
}

