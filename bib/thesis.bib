  file = {zotmoov/Stuff/Main/Neural networks and markets/Rezek et al_2005_Unifying learning in games and graphical models.pdf;zotmoov/Stuff/Main/Neural networks and markets/Rezek et al_2005_Unifying learning in games and graphical models.html},
  collection = {/Main/Neural networks and markets}
}

