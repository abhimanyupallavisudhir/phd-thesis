 file = {/home/manyu/gdrive/Gittable/Bib/zotmoov/Stuff/lampposts/elicitation/Karger et al. - 2021 - Reciprocal Scoring A Method for Forecasting Unanswerable Questions.pdf},
 keywords = {causal inference,COVID-19,elicitation,forecasting tournaments,policy evaluation},
 langid = {english},
 month = {October},
