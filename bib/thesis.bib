@inproceedings{baumCodeEvolutionArtificial2002,
  title = {Toward {{Code Evolution}} by {{Artificial Economies}}},
  booktitle = {Evolution as {{Computation}}},
  author = {Baum, Eric B. and Durdanovic, Igor},
